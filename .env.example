POSTGRES_DB=cloudsentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-a-unique-local-development-password
POSTGRES_HOST_PORT=5432
POSTGRES_HOST=127.0.0.1
CLOUDSENTINEL_API_BASE_URL=
# Comma-separated browser origins when the dashboard is hosted separately.
CLOUDSENTINEL_CORS_ORIGINS=
CLOUDSENTINEL_API_TOKEN=
CLOUDSENTINEL_GATEWAY_SECRET=
CLOUDSENTINEL_ENV=development
CLOUDSENTINEL_ALLOWED_HOSTS=
# In production, checks require an approved hostname/domain. Comma-separated;
# matching includes the domain itself and its subdomains.
CLOUDSENTINEL_TARGET_ALLOWLIST=
# API request limits per client IP per rolling minute (per API process).
CLOUDSENTINEL_AUTH_RATE_LIMIT=10
CLOUDSENTINEL_GATEWAY_RATE_LIMIT=120
CLOUDSENTINEL_CHECK_RATE_LIMIT=60
CLOUDSENTINEL_SCHEDULE_RATE_LIMIT=20
CLOUDSENTINEL_REPUTATION_RATE_LIMIT=30
ALERT_EMAIL_DEV_MODE=true
ALERT_EMAIL_ON_RESOLVE=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=false
ALERT_EMAIL_TO=
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
VIRUSTOTAL_API_KEY=

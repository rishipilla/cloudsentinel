
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "cloudsentinel-web": {
      "root": ".",
      "entrypoint": "services/api/main.py",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "cloudsentinel-web"
      }
    }
  ]
}
